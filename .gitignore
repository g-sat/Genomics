__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
*.pt
.DS_Store
Thumbs.db

# Hail writes session logs in the working directory. They are not results.
hail-*.log
logs/

# Layout bytes uploaded to HDFS. The measurement JSON stays.
results/transfer/**/part-*

# Parquet files are rebuilt by experiments/measure_parquet.py
# and experiments/measure_parquet_unified.py. Reports stay.
results/**/*.parquet

# Built from docs/problem_and_results.md with docs/print.css.
docs/*.pdf
docs/*.html

# Public 1000 Genomes genotypes. The panel file and the measurement stay.
data/genotypes/*.vcf.gz
data/genotypes/*.tbi
data/*.vcf

# Packed dosage blocks from experiments/real_stitch.py. The JSON report stays.
results/real_stitch/*.bin
